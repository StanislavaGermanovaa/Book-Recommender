<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns="http://www.semanticweb.org/stany/ontologies/2026/5/untitled-ontology-25/"
    xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
    xmlns:books="http://www.semanticweb.org/ontologies/books#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:swrl="http://www.w3.org/2003/11/swrl#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about=""/>
  <owl:Class rdf:ID="ClassicBook">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:ID="Book"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#int"
                    >1980</xsd:maxInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
              </rdfs:Datatype>
            </owl:someValuesFrom>
            <owl:onProperty>
              <owl:FunctionalProperty rdf:ID="hasPublicationYear"/>
            </owl:onProperty>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="CultClassic">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:ID="Bestseller"/>
          <owl:Class rdf:about="#ClassicBook"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="AudioPublisher">
    <rdfs:subClassOf>
      <owl:Class rdf:ID="Publisher"/>
    </rdfs:subClassOf>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Publisher"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <owl:Class rdf:ID="AudioBook"/>
            </owl:someValuesFrom>
            <owl:onProperty>
              <owl:IrreflexiveProperty rdf:ID="isPublisherOf">
                <rdfs:range rdf:resource="#Book"/>
                <rdfs:domain rdf:resource="#Publisher"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
                <owl:inverseOf>
                  <owl:IrreflexiveProperty rdf:ID="publishedBy">
                    <rdfs:range rdf:resource="#Publisher"/>
                    <rdfs:domain rdf:resource="#Book"/>
                    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
                    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
                    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
                    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
                  </owl:IrreflexiveProperty>
                </owl:inverseOf>
                <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
              </owl:IrreflexiveProperty>
            </owl:onProperty>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="BestsellingPublisher">
    <rdfs:subClassOf rdf:resource="#Publisher"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Publisher"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <owl:Class rdf:about="#Bestseller"/>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#isPublisherOf"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="Author"/>
  <owl:Class rdf:about="#AudioBook">
    <rdfs:subClassOf rdf:resource="#Book"/>
  </owl:Class>
  <owl:Class rdf:ID="RecommendedFantasy">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <books:Fantasy rdf:ID="Fantasy">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
                <rdfs:subClassOf>
                  <owl:Class rdf:ID="Fiction"/>
                </rdfs:subClassOf>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
              </books:Fantasy>
            </owl:someValuesFrom>
            <owl:onProperty>
              <owl:IrreflexiveProperty rdf:ID="hasGenre">
                <rdfs:range>
                  <owl:Class rdf:ID="Genre"/>
                </rdfs:range>
                <rdfs:domain rdf:resource="#Book"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
                <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
              </owl:IrreflexiveProperty>
            </owl:onProperty>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="RecommendedHistoricalFiction">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <books:HistoricalFiction rdf:ID="HistoricalFiction">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
                <rdfs:subClassOf>
                  <owl:Class rdf:about="#Fiction"/>
                </rdfs:subClassOf>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
              </books:HistoricalFiction>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#hasGenre"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="#Bestseller">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Book"/>
          <owl:Restriction>
            <owl:hasValue>
              <books:BookRating rdf:ID="FiveStar">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
              </books:BookRating>
            </owl:hasValue>
            <owl:onProperty>
              <owl:IrreflexiveProperty rdf:ID="hasRating">
                <rdfs:range>
                  <owl:Class rdf:ID="BookRating"/>
                </rdfs:range>
                <rdfs:domain rdf:resource="#Book"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
                <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
              </owl:IrreflexiveProperty>
            </owl:onProperty>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="PrintBestSeller">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Class rdf:ID="PrintBook"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="SciFiAuthor">
    <rdfs:subClassOf rdf:resource="#Author"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Author"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Class rdf:about="#Book"/>
                  <owl:Restriction>
                    <owl:someValuesFrom>
                      <books:SciFi rdf:ID="SciFi">
                        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
                        <rdfs:subClassOf>
                          <owl:Class rdf:about="#Fiction"/>
                        </rdfs:subClassOf>
                        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
                      </books:SciFi>
                    </owl:someValuesFrom>
                    <owl:onProperty rdf:resource="#hasGenre"/>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
            </owl:someValuesFrom>
            <owl:onProperty>
              <owl:IrreflexiveProperty rdf:ID="authorOf">
                <rdfs:range rdf:resource="#Book"/>
                <rdfs:domain rdf:resource="#Author"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
                <owl:inverseOf>
                  <owl:IrreflexiveProperty rdf:ID="writtenBy">
                    <rdfs:range rdf:resource="#Author"/>
                    <rdfs:domain rdf:resource="#Book"/>
                    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
                    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
                    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
                    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
                  </owl:IrreflexiveProperty>
                </owl:inverseOf>
                <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
              </owl:IrreflexiveProperty>
            </owl:onProperty>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="RecommendedHorror">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <books:Horror rdf:ID="Horror">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
                <rdfs:subClassOf>
                  <owl:Class rdf:about="#Fiction"/>
                </rdfs:subClassOf>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
              </books:Horror>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#hasGenre"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="User"/>
  <owl:Class rdf:ID="AudioBestseller">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#AudioBook"/>
          <owl:Class rdf:about="#Bestseller"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="FantasyAuthor">
    <rdfs:subClassOf rdf:resource="#Author"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Author"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Class rdf:about="#Book"/>
                  <owl:Restriction>
                    <owl:someValuesFrom rdf:resource="#Fantasy"/>
                    <owl:onProperty rdf:resource="#hasGenre"/>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#authorOf"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="#Fiction">
    <owl:disjointWith>
      <owl:Class rdf:ID="NonFiction"/>
    </owl:disjointWith>
    <rdfs:subClassOf rdf:resource="#Genre"/>
  </owl:Class>
  <owl:Class rdf:ID="RecommendedActionAdventure">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <books:ActionAdventure rdf:ID="ActionAdventure">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
                <rdfs:subClassOf rdf:resource="#Fiction"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
              </books:ActionAdventure>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#hasGenre"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="EBestSeller">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Class rdf:ID="EBook"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="BestsellingAuthor">
    <rdfs:subClassOf rdf:resource="#Author"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Author"/>
          <owl:Restriction>
            <owl:someValuesFrom rdf:resource="#Bestseller"/>
            <owl:onProperty rdf:resource="#authorOf"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="RecommendedSciFi">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Restriction>
            <owl:someValuesFrom rdf:resource="#SciFi"/>
            <owl:onProperty rdf:resource="#hasGenre"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="RecommendedMystery">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <books:Mystery rdf:ID="Mystery">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
                <rdfs:subClassOf rdf:resource="#Fiction"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
              </books:Mystery>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#hasGenre"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="RecommendedRomance">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <books:Romance rdf:ID="Romance">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
                <rdfs:subClassOf rdf:resource="#Fiction"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
              </books:Romance>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#hasGenre"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="RecommendedHistory">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <books:History rdf:ID="History">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
                <rdfs:subClassOf>
                  <owl:Class rdf:about="#NonFiction"/>
                </rdfs:subClassOf>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
              </books:History>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#hasGenre"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="SeriesFirstVolume">
    <rdfs:subClassOf rdf:resource="#Book"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Book"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <owl:Class rdf:ID="BookSeries"/>
            </owl:someValuesFrom>
            <owl:onProperty>
              <owl:IrreflexiveProperty rdf:ID="isPartOfSeries">
                <rdfs:range rdf:resource="#BookSeries"/>
                <rdfs:domain rdf:resource="#Book"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
                <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
              </owl:IrreflexiveProperty>
            </owl:onProperty>
          </owl:Restriction>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
            >1</owl:hasValue>
            <owl:onProperty>
              <owl:FunctionalProperty rdf:ID="hasSeriesOrder"/>
            </owl:onProperty>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="AverageBook">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Book"/>
          <owl:Restriction>
            <owl:hasValue>
              <books:BookRating rdf:ID="ThreeStar">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
              </books:BookRating>
            </owl:hasValue>
            <owl:onProperty rdf:resource="#hasRating"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="#PrintBook">
    <rdfs:subClassOf rdf:resource="#Book"/>
  </owl:Class>
  <owl:Class rdf:about="#NonFiction">
    <rdfs:subClassOf rdf:resource="#Genre"/>
  </owl:Class>
  <owl:Class rdf:about="#BookRating">
    <owl:equivalentClass>
      <owl:Class>
        <owl:oneOf rdf:parseType="Collection">
          <books:BookRating rdf:about="#FiveStar"/>
          <books:BookRating rdf:ID="FourStar">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
          </books:BookRating>
          <books:BookRating rdf:ID="OneStar">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
          </books:BookRating>
          <books:BookRating rdf:about="#ThreeStar"/>
          <books:BookRating rdf:ID="TwoStar">
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
          </books:BookRating>
        </owl:oneOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="AwardWinningSciFi">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Restriction>
            <owl:someValuesFrom rdf:resource="#Mystery"/>
            <owl:onProperty rdf:resource="#hasGenre"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="SciFiPublisher">
    <rdfs:subClassOf rdf:resource="#Publisher"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Publisher"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Class rdf:about="#Book"/>
                  <owl:Restriction>
                    <owl:someValuesFrom rdf:resource="#SciFi"/>
                    <owl:onProperty rdf:resource="#hasGenre"/>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#isPublisherOf"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="GlobalPublisher">
    <rdfs:subClassOf rdf:resource="#Publisher"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Publisher"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Class rdf:about="#Book"/>
                  <owl:Restriction>
                    <owl:someValuesFrom rdf:resource="#Fiction"/>
                    <owl:onProperty rdf:resource="#hasGenre"/>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#isPublisherOf"/>
          </owl:Restriction>
          <owl:Restriction>
            <owl:someValuesFrom>
              <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                  <owl:Class rdf:about="#Book"/>
                  <owl:Restriction>
                    <owl:someValuesFrom rdf:resource="#NonFiction"/>
                    <owl:onProperty rdf:resource="#hasGenre"/>
                  </owl:Restriction>
                </owl:intersectionOf>
              </owl:Class>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#isPublisherOf"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="DebutingAuthor">
    <rdfs:subClassOf rdf:resource="#Author"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Author"/>
          <owl:Restriction>
            <owl:onClass rdf:resource="#Book"/>
            <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
            >1</owl:qualifiedCardinality>
            <owl:onProperty rdf:resource="#authorOf"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:ID="RecommendedDrama">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <owl:Class rdf:about="#Bestseller"/>
          <owl:Restriction>
            <owl:someValuesFrom>
              <books:Drama rdf:ID="Drama">
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
                <rdfs:subClassOf rdf:resource="#Fiction"/>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
              </books:Drama>
            </owl:someValuesFrom>
            <owl:onProperty rdf:resource="#hasGenre"/>
